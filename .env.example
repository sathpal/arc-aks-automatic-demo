# Copy to .env and edit. Everything else reads this file.
LOCATION=australiaeast            # any region where you have (or can get) 16 vCPUs of quota in a D4 family
RG=rg-arc-auto-lab
CLUSTER=arc-auto-lab
GITHUB_OWNER=your-github-user     # the owner of YOUR fork of this repo
GITHUB_REPO=arc-aks-automatic-demo
GITHUB_BRANCH=main
RUNNER_SET_NAME=arc-auto-runners  # becomes the runs-on label in the workflow
ARC_SYSTEMS_NAMESPACE=arc-systems
ARC_RUNNERS_NAMESPACE=arc-runners
QUOTA_FAMILY=standardDaldv6Family # VM family to request quota for (see README, Troubleshooting)
QUOTA_CORES=48
